# คัดลอกไฟล์นี้ไปเป็น `.env` ในโฟลเดอร์ core-api/ แล้วเติมค่าจริง
# คำสั่ง: cp .env.example .env   (Windows: copy .env.example .env)

# ---------- จำเป็น (server จะไม่ start ถ้าไม่มี) ----------
# PostgreSQL/TimescaleDB connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sovereign

# ต้องยาว >= 16 ตัวอักษรแบบสุ่ม เช่น openssl rand -hex 32
JWT_SECRET=เปลี่ยนเป็นค่า random ที่ยาวอย่างน้อย 16 ตัวอักษร

# ---------- ทางเลือก (มีค่า default) ----------
PORT=3001

# MQTT (EMQX)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# TimescaleDB (ใช้โดย MQTT ingestion worker)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=sovereign
TIMESCALE_USER=
TIMESCALE_PASSWORD=

# Telegram alert bot (ถ้าไม่ตั้งจะไม่ส่งแจ้งเตือนผ่าน Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# AI agent approvals ผ่าน Telegram:
# - แจ้งเตือนพร้อมปุ่ม ✅ อนุมัติ / 🚫 ปฏิเสธ ทุกครั้งที่ AI ขออนุมัติ action
# - ใช้ long polling (getUpdates) — ไม่ต้องเปิดพอร์ตสาธารณะ
# - รับคำสั่ง /approve <id> หรือ /reject <id> ได้จาก TELEGRAM_CHAT_ID ด้านบนเท่านั้น (chat อื่นถูก ignore)

# Edge AI / Ollama
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=gemma3:4b

# ---------- AI Agent Policy (blockIP / unblockIP / killProcess) ----------
# ระดับ autonomy ของ AI agent:
#   view        = ดูข้อมูลอย่างเดียว (ห้ามใช้ action tools)
#   suggest     = แนะนำ + ขออนุมัติจาก Superadmin ก่อนดำเนินการ (ค่า default)
#   autonomous  = ลงมือเองทันที (guard ยังทำงานเสมอ)
AGENT_AUTONOMY=suggest
# IP ที่ห้าม block โดยเด็ดขาด (คั่นด้วย ,) เช่น gateway หรือเครื่องบริการอื่น
# AGENT_PROTECTED_IPS=192.168.1.1
# ชื่อ process ที่ห้าม kill เพิ่มเติม (คั่นด้วย ,) — ระบบมีรายชื่อสำคัญอยู่แล้ว
# AGENT_PROTECTED_PROCESSES=
# อายุของคำขออนุมัติ (ms) — เกินกำหนดจะถูกปฏิเสธอัตโนมัติ (default 900000 = 15 นาที)
# AGENT_APPROVAL_TTL_MS=900000

# Backup & Restore
# BACKUP_DIR=./backups
# DB_CONTAINER=sovereign-db

# OTA (ESP32) — ตั้ง OTA_BASE_URL เป็น IP/โดเมนที่ ESP เข้าถึง core-api ได้
OTA_BASE_URL=http://192.168.1.10:3001
# OTA_DIR=./ota_firmwares
# OTA_TOKEN=เปลี่ยนเป็นค่า secret ถ้าอยากกันคนนอกดาวน์โหลด firmware

# Energy Management — ความจุแบตเตอรี่ (kWh) ใช้คำนวณเวลาที่เหลือ
ENERGY_CAPACITY_KWH=5

# Seed script: ถ้าไม่ตั้ง ระบบจะสุ่มรหัสผ่าน admin ให้อัตโนมัติ (แสดงใน console)
SEED_ADMIN_PASSWORD=

# ---------- Production hardening ----------
# NODE_ENV=production
# ตั้ง TLS_CERT/TLS_KEY (path ไฟล์ PEM) เพื่อรัน API ผ่าน HTTPS (เซ็ตทั้งคู่)
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem
# จำกัด origin ที่เชื่อม API ได้ (คั่นด้วย ,) — production ควรตั้งเป็นโดเมนหน้าเว็บ
# CORS_ORIGIN=http://localhost:3000

# ---------- Threat Detection (ตรวจ IP ภายนอกใหม่ + connection spike) ----------
# ตั้งเป็น false เพื่อปิด
THREAT_DETECTION_ENABLED=true
# ตรวจทุกกี่ ms (default 60000 = 1 นาที)
# THREAT_CHECK_INTERVAL_MS=60000
# จำนวนการเชื่อมต่อที่ถือว่า "สูงผิดปกติ" (spike)
# THREAT_CONNECTION_THRESHOLD=100
# กัน alert ซ้ำ IP เดียวในระยะนี้ (ms)
# THREAT_IP_COOLDOWN_MS=600000
# จำ IP ใน baseline ได้นานเท่าไหร่ (ms) — พ้นแล้วถ้าโผล่ใหม่ถือเป็น "ใหม่"
# THREAT_BASELINE_WINDOW_MS=3600000
# IP ที่ไม่ต้องเตือน (คั่นด้วย ,)
# THREAT_ALLOWLIST_IPS=
# opt-in: block IP อัตโนมัติเมื่อเจอ IP ใหม่ภายนอก — ใช้ {ip} เป็น placeholder
# เช่น Windows:
# FIREWALL_BLOCK_CMD=netsh advfirewall firewall add rule name="SovereignBlock" dir=in action=block remoteip={ip}
# (ปล่อยว่าง = ปิด auto-block)

# ---------- Semantic Search (ค้นหาคู่มือด้วยความหมาย) ----------
# ต้องมี embedding model ใน Ollama (เช่น nomic-embed-text / mxbai-embed-large)
# EMBED_MODEL=nomic-embed-text

# ---------- PromptPay QR (โอนเงินจริง — Transfer Orders) ----------
# เบอร์โทรศัพท์ 10 หลัก (08XXXXXXXX) หรือเลขบัตรประชาชน 13 หลัก ของบัญชีรับเงิน
# ว่าง = สร้างคำสั่งโอนได้ แต่ไม่มี QR (ยืนยันด้วย txid อย่างเดียว)
PROMPTPAY_TARGET=
PROMPTPAY_NAME=SOVEREIGN
# อัตราแปลงยอดบาทเมื่อไม่ระบุ amountThb (บาทต่อดอลลาร์)
USD_THB_RATE=35

# ---------- Dime! Statement (สเตตเมนต์รายเดือนจาก Dime → อัปเดตพอร์ตอัตโนมัติ) ----------
# วงจร: อีเมล unread (IMAP) → PDF → parse หุ้น US → upsert AssetPosition + AssetPrice
# ตั้ง DIME_ENABLED=true + DIME_IMAP_* ให้ครบถึงจะเปิด cron (ค่า default ปิด)
DIME_ENABLED=false
# ดู cron ต้องการ DIME_ENABLED=true
# DIME_IMAP_HOST=imap.example.com
# DIME_IMAP_PORT=993
# DIME_IMAP_USER=me@example.com
# DIME_IMAP_PASS=
# DIME_IMAP_TLS=true
# DIME_IMAP_MAILBOX=INBOX
# ย้อนหลังกี่วันให้ค้นหาอีเมลที่ยังไม่ได้อ่าน (กันรื้อกล่องจดหมาย)
# DIME_LOOKBACK_DAYS=45
# รหัสเปิด PDF ถ้าสเตตเมนต์ล็อก (Dime ใช้เลขบัตร/วันเกิด ใส่ผ่าน env ที่ server เท่านั้น)
# DIME_PDF_PASSWORD=
# เจ้าของพอร์ตที่สเตตเมนต์อัปเดต (username) — ว่าง = SUPERADMIN ตัวแรก
# DIME_OWNER_USERNAME=krisakorn
# เวลา fetch อัตโนมัติ (node-cron, ตาม timezone ของ container — เริ่มจาก 09:00)
# DIME_FETCH_CRON=0 9 * * *
