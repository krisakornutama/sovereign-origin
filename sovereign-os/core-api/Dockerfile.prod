# ── Production build (multi-stage): compile TS → node dist ──
# 04/11/69: node:18 → node:22-alpine (เจ้าของสั่งเมื่อ build/migrate สะดุด)
# เหตุผล: frontend ต้อง ≥ Node 20.9 อยู่แล้ว ⇒ ให้ API/migrate รุ่นเดียวกัน
#         ลดปัญหา Prisma engine + ESM ไม่ตรงกัน และ alpine ทำให้ image เล็กลงมาก (สำคัญกับ Raspberry Pi)
FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat
COPY package*.json ./
# npm ci เร็วกว่าและ reproducibly ตรง lock · ถ้า lock ไม่ตรง package.json ค่อยตกไป install
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY . .
RUN npx prisma generate && npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
# Survival: pg_dump/psql ใน container — backup DB ผ่าน docker network ได้โดยไม่ต้อง mount docker socket
# + rsync/openssh-client สำหรับ offsite replication ไป remote server (MESH_RSYNC_TARGET / MESH_SCP_TARGET)
# + openssl/libc6-compat: Prisma query engine บน musl ต้องมี
RUN apk add --no-cache openssl libc6-compat postgresql-client rsync openssh-client
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/knowledge ./knowledge
COPY --from=build /app/scripts ./scripts
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm", "start"]
