import { Router } from 'express';
import { authenticate, requireRole } from '../../middleware/auth.middleware';
import { agentPolicy, AGENT_TOOLS } from '../../services/agent-policy.service';
import { agentActions } from '../../services/agent-actions.service';
import * as chatMemory from '../../services/chat-memory.service';
import * as advisor from '../../services/advisor.service';
import axios from 'axios';
import os from 'os';
import { getModelForTask } from '../../services/ai-router.service';
import { prisma } from '../../lib/prisma';

const OLLAMA_URL = process.env.OLLAMA_URL || 'http://127.0.0.1:11434';
const CURRENT_MODEL = process.env.AI_MODEL || 'gemma3:4b';

const router = Router();

// Heuristic voice command parser (fallback when Ollama is slow/unavailable)
function parseVoiceCommandHeuristic(text: string): any {
  const t = text.toLowerCase().trim();
  
  // Intent detection
  let intent = 'help';
  if (/(à¹€à¸žà¸´à¹ˆà¸¡|à¹ƒà¸ªà¹ˆ|à¹€à¸žà¸´à¹ˆà¸¡à¹€à¸‚à¹‰à¸²).*(à¸™à¹‰à¸³|water)/.test(t)) intent = 'inventory_add';
  else if (/(à¸™à¸³à¸­à¸­à¸|à¹€à¸­à¸²à¸­à¸­à¸|à¸¥à¸”).*(à¸™à¹‰à¸³|water)/.test(t)) intent = 'inventory_remove';
  else if (/(à¹€à¸žà¸´à¹ˆà¸¡|à¹ƒà¸ªà¹ˆ).*(à¸­à¸²à¸«à¸²à¸£|à¸‚à¹‰à¸²à¸§|à¸œà¸±à¸|à¸œà¸¥à¹„à¸¡à¹‰|food)/.test(t)) intent = 'inventory_add';
  else if (/(à¹€à¸à¹‡à¸šà¹€à¸à¸µà¹ˆà¸¢à¸§|à¹€à¸à¹‡à¸š).*(à¸‚à¹‰à¸²à¸§|à¸œà¸±à¸|à¸œà¸¥à¹„à¸¡à¹‰|crop)/.test(t)) intent = 'farm_harvest';
  else if (/(à¸›à¸¥à¸¹à¸|à¸«à¸§à¹ˆà¸²à¸™).*(à¸‚à¹‰à¸²à¸§|à¸œà¸±à¸|crop)/.test(t)) intent = 'farm_plant';
  else if (/(à¸„à¸§à¸²à¸¡à¸”à¸±à¸™|bp|à¸šà¸µà¸žà¸µ)/.test(t)) intent = 'health_bp';
  else if (/(à¸™à¹‰à¸³à¸«à¸™à¸±à¸|weight)/.test(t)) intent = 'health_weight';
  else if (/(à¸™à¹‰à¸³à¸•à¸²à¸¥|sugar|glucose)/.test(t)) intent = 'health_sugar';
  else if (/(à¸ªà¸±à¹ˆà¸‡|order).*(à¸­à¸²à¸«à¸²à¸£|à¸‚à¹‰à¸²à¸§|menu)/.test(t)) intent = 'restaurant_order';
  else if (/(à¸ˆà¹ˆà¸²à¸¢|pay|à¸Šà¸³à¸£à¸°)/.test(t)) intent = 'restaurant_pay';
  else if (/(à¹€à¸Šà¹‡à¸„|check).*(à¹€à¸‹à¹‡à¸™à¹€à¸‹à¸­à¸£à¹Œ|sensor|à¸™à¹‰à¸³|water|à¹à¸šà¸•|battery)/.test(t)) intent = 'sensor_check';
  else if (/(à¸ªà¸–à¸²à¸™à¸°|status).*(à¸£à¸°à¸šà¸š|system)/.test(t)) intent = 'system_status';

  // Kids domain
  else if (/(à¸‡à¸²à¸™à¸šà¹‰à¸²à¸™|chore|à¸ à¸²à¸£à¸°)/.test(t)) intent = 'kids_chore';
  else if (/(à¸šà¸´à¸¥|cost|à¸„à¹ˆà¸²à¹ƒà¸Šà¹‰à¸ˆà¹ˆà¸²à¸¢|cost).*(à¸¥à¸¹à¸|kid|con)/.test(t)) intent = 'kids_bill';
  else if (/(à¸„à¹ˆà¸²à¸‚à¸™à¸¡|allowance|à¹€à¸‡à¸´à¸™à¸à¸´à¸™|pocket money)/.test(t)) intent = 'kids_allowance';
  else if (/(à¹à¸¥à¸à¸„à¸¹à¸›à¸­à¸‡|redeem|coupon)/.test(t)) intent = 'kids_coupon';
  else if (/(à¹€à¸£à¸µà¸¢à¸™|lesson|quiz|à¹à¸šà¸šà¸—à¸”à¸ªà¸­à¸š|à¸„à¸°à¹à¸™à¸™)/.test(t)) intent = 'kids_lesson';
  else if (/(à¸žà¸­à¸£à¹Œà¸•|portfolio|à¸«à¸¸à¹‰à¸™|stock).*(à¸¥à¸¹à¸|kid)/.test(t)) intent = 'kids_portfolio';
  else if (/(à¸à¸£à¸°à¸›à¸¸à¸|piggy|à¹€à¸à¹‡à¸šà¹€à¸‡à¸´à¸™|à¸­à¸­à¸¡)/.test(t)) intent = 'kids_piggy';

  // Security/Relay/Automation
  else if (/(à¸£à¸µà¹€à¸¥à¸¢à¹Œ|relay|à¸ªà¸§à¸´à¸•à¸Šà¹Œ|switch|à¸›à¸´à¸”|à¹€à¸›à¸´à¸”).*(à¹„à¸Ÿ|light|à¸›à¸±à¹Šà¸¡|pump|à¸žà¸±à¸”à¸¥à¸¡|fan)/.test(t)) intent = 'relay_control';
  else if (/(à¸­à¸±à¸•à¹‚à¸™à¸¡à¸±à¸•à¸´|automation|à¸à¸Ž|rule).*(à¹€à¸žà¸´à¹ˆà¸¡|à¹€à¸žà¸´à¹ˆà¸¡à¹€à¸‚à¹‰à¸²|à¸ªà¸£à¹‰à¸²à¸‡|create)/.test(t)) intent = 'automation_create';
  else if (/(à¸­à¸±à¸•à¹‚à¸™à¸¡à¸±à¸•à¸´|automation|à¸à¸Ž|rule).*(à¸¥à¸š|delete|à¸›à¸´à¸”|disable)/.test(t)) intent = 'automation_delete';
  else if (/(à¸„à¸§à¸²à¸¡à¸›à¸¥à¸­à¸”à¸ à¸±à¸¢|security|à¸à¸¥à¹‰à¸­à¸‡|camera|à¸à¸²à¸£à¸•à¸£à¸§à¸ˆà¸ˆà¸±à¸š|detection)/.test(t)) intent = 'security_check';
  else if (/(à¸¥à¹‡à¸­à¸|lock|à¸›à¸¥à¸”à¸¥à¹‡à¸­à¸|unlock).*(à¸›à¸£à¸°à¸•à¸¹|door|à¸›à¸£à¸°à¸•à¸¹à¸«à¸™à¹‰à¸²|front door)/.test(t)) intent = 'door_lock';

  // Energy/Power
  else if (/(à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™|energy|à¹„à¸Ÿà¸Ÿà¹‰à¸²|electric|à¹à¸šà¸•à¹€à¸•à¸­à¸£à¸µà¹ˆ|battery|à¹‚à¸‹à¸¥à¹ˆà¸²|solar|inverter)/.test(t)) intent = 'energy_status';
  else if (/(à¸Šà¸²à¸£à¹Œà¸ˆ|charge|à¸Šà¸²à¸£à¹Œà¸ˆ).*(à¹à¸šà¸•|battery|à¹‚à¸‹à¸¥à¹ˆà¸²|solar)/.test(t)) intent = 'energy_charge';

  // Query intents (ask about status/behavior)
  else if (/(à¸¥à¸¹à¸|kid|con).*(à¸—à¸³à¸­à¸°à¹„à¸£|à¸—à¸³à¹„à¸£|à¸žà¸¤à¸•à¸´à¸à¸£à¸£à¸¡|behavior|à¹€à¸£à¸µà¸¢à¸™|à¹€à¸£à¸µà¸¢à¸™à¸£à¸¹à¹‰|course|progress)/.test(t)) intent = 'kids_query';
  else if (/(à¹€à¸‹à¹‡à¸™à¹€à¸‹à¸­à¸£à¹Œ|sensor|à¸™à¹‰à¸³|water|à¹à¸šà¸•|battery|à¹„à¸Ÿ|power|à¹„à¸Ÿà¸Ÿà¹‰à¸²).*(à¸ªà¸–à¸²à¸™à¸°|status|à¸„à¹ˆà¸²|value|à¸„à¸·à¸­à¹€à¸—à¹ˆà¸²à¹„à¸«à¸£à¹ˆ|à¹€à¸—à¹ˆà¸²à¹„à¸«à¸£à¹ˆ)/.test(t)) intent = 'sensor_query';
  else if (/(à¸£à¸°à¸šà¸š|system|à¹€à¸‹à¸´à¸£à¹Œà¸Ÿà¹€à¸§à¸­à¸£à¹Œ|server).*(à¸ªà¸–à¸²à¸™à¸°|status|à¸›à¸à¸•à¸´à¹„à¸«à¸¡|à¸›à¸à¸•à¸´à¹„à¸«à¸¡|à¸—à¸³à¸‡à¸²à¸™à¹„à¸«à¸¡)/.test(t)) intent = 'system_query';
  else if (/(à¸Ÿà¸²à¸£à¹Œà¸¡|farm|à¹à¸›à¸¥à¸‡|plot|à¸žà¸·à¸Š|crop|à¹€à¸à¹‡à¸šà¹€à¸à¸µà¹ˆà¸¢à¸§|harvest).*(à¸ªà¸–à¸²à¸™à¸°|status|à¸žà¸£à¹‰à¸­à¸¡à¹„à¸«à¸¡|à¸žà¸£à¹‰à¸­à¸¡à¹„à¸«à¸¡|à¹€à¸¡à¸·à¹ˆà¸­à¹„à¸«à¸£à¹ˆ)/.test(t)) intent = 'farm_query';
  else if (/(à¸„à¸¥à¸±à¸‡|inventory|à¸‚à¸­à¸‡|stock|à¸§à¸±à¸•à¸–à¸¸à¸”à¸´à¸š|ingredient).*(à¸¡à¸µà¸­à¸°à¹„à¸£|à¸¡à¸µà¹€à¸—à¹ˆà¸²à¹„à¸«à¸£à¹ˆ|à¹€à¸«à¸¥à¸·à¸­à¹€à¸—à¹ˆà¸²à¹„à¸«à¸£à¹ˆ|à¸«à¸¡à¸”à¸­à¸°à¹„à¸£)/.test(t)) intent = 'inventory_query';
  else if (/(à¸¥à¸¹à¸|kid|con).*(à¸à¸´à¸™|à¸à¸´à¸™à¸­à¸°à¹„à¸£|à¸à¸´à¸™à¹à¸¥à¹‰à¸§à¹„à¸«à¸¡|à¸à¸´à¸™à¸¢à¸±à¸‡|à¸­à¸²à¸«à¸²à¸£|food)/.test(t)) intent = 'kids_food_query';
  else if (/(à¹€à¸‡à¸´à¸™|money|à¸à¸£à¸°à¹€à¸›à¹‹à¸²|wallet|à¸žà¸­à¸£à¹Œà¸•|portfolio|à¸«à¸¸à¹‰à¸™|stock|à¸à¸³à¹„à¸£|profit|à¸‚à¸²à¸”à¸—à¸¸à¸™|loss)/.test(t)) intent = 'finance_query';

  // Help
  else if (/(à¸Šà¹ˆà¸§à¸¢|help|à¸§à¸´à¸˜à¸µà¹ƒà¸Šà¹‰|à¸§à¸´à¸˜à¸µ|à¸„à¸³à¸ªà¸±à¹ˆà¸‡|command|à¸—à¸³à¹„à¸”à¹‰à¸­à¸°à¹„à¸£|à¸—à¸³à¹„à¸”à¹‰à¸­à¸°à¹„à¸£)/.test(t)) intent = 'help';

  // Entity extraction
  const entities: any = {};
  
  // Numbers with units
  const qtyMatch = t.match(/(\d+(?:\.\d+)?)\s*(à¸¥à¸´à¸•à¸£|à¸¥|à¸à¸´à¹‚à¸¥à¸à¸£à¸±à¸¡|à¸à¸´à¹‚à¸¥|à¸à¸\.|à¸à¸´à¹‚à¸¥à¸à¸£à¸±à¸¡|mg\/dl|mmhg|à¸ˆà¸²à¸™|à¸Šà¸´à¹‰à¸™|à¸–à¹‰à¸§à¸¢|à¸Šà¹‰à¸­à¸™)/);
  if (qtyMatch) {
    entities.quantity = parseFloat(qtyMatch[1]);
    entities.unit = qtyMatch[2].replace('à¸à¸´à¹‚à¸¥à¸à¸£à¸±à¸¡', 'à¸à¸´à¹‚à¸¥à¸à¸£à¸±à¸¡').replace('à¸à¸.', 'à¸à¸´à¹‚à¸¥à¸à¸£à¸±à¸¡').replace('à¸à¸´à¹‚à¸¥', 'à¸à¸´à¹‚à¸¥à¸à¸£à¸±à¸¡').replace('à¸¥à¸´à¸•à¸£', 'à¸¥à¸´à¸•à¸£').replace('à¸¥', 'à¸¥à¸´à¸•à¸£');
  }

  // Water
  if (/(à¸™à¹‰à¸³|water)/.test(t)) entities.category = 'water';
  
  // Blood pressure
  const bpMatch = t.match(/(\d{2,3})\s*[/\\\/]\s*(\d{2,3})/);
  if (bpMatch) {
    entities.systolic = parseInt(bpMatch[1]);
    entities.diastolic = parseInt(bpMatch[2]);
  }

  // Numbers without units (generic value)
  const numMatch = t.match(/(?:à¸„à¹ˆà¸²|value|à¹€à¸Šà¹‡à¸„|check)\s*(\d+(?:\.\d+)?)/);
  if (numMatch && !entities.value) entities.value = parseFloat(numMatch[1]);

  // Table number
  const tableMatch = t.match(/(à¹‚à¸•à¹Šà¸°|table)\s*([A-Z]?\d+)/i);
  if (tableMatch) entities.table = tableMatch[2].toUpperCase();

  // Payment
  if (/promptpay|à¸žà¸£à¸­à¸¡à¸•à¹Œà¹€à¸žà¸¢à¹Œ/.test(t)) entities.payment = 'promptpay';
  else if (/à¹€à¸‡à¸´à¸™à¸ªà¸”|cash/.test(t)) entities.payment = 'cash';

  // Kids entities
  if (/(à¸¥à¸¹à¸|kid|con|à¸¥à¸¹à¸à¸Šà¸²à¸¢|à¸¥à¸¹à¸à¸ªà¸²à¸§|son|daughter)/.test(t)) {
    const kidNameMatch = t.match(/(à¸¥à¸¹à¸|kid|con|à¸¥à¸¹à¸à¸Šà¸²à¸¢|à¸¥à¸¹à¸à¸ªà¸²à¸§|son|daughter)\s*([à¸-à¹™a-zA-Z]+)/);
    if (kidNameMatch) entities.kidName = kidNameMatch[2];
  }
  if (/(à¸Šà¹‡à¸­à¸„|chore|à¸ à¸²à¸£à¸°|à¸‡à¸²à¸™à¸šà¹‰à¸²à¸™|à¸—à¸³|à¸—à¸³à¹„à¸£)/.test(t)) entities.choreType = 'chore';
  if (/(à¸šà¸´à¸¥|bill|à¸„à¹ˆà¸²à¹ƒà¸Šà¹‰à¸ˆà¹ˆà¸²à¸¢|cost|à¸ˆà¹ˆà¸²à¸¢)/.test(t)) entities.billType = 'bill';
  if (/(à¸„à¸¹à¸›à¸­à¸‡|coupon|à¹à¸¥à¸|redeem|à¸£à¸²à¸‡à¸§à¸±à¸¥|reward)/.test(t)) entities.couponType = 'coupon';
  if (/(à¸šà¸—à¹€à¸£à¸µà¸¢à¸™|lesson|à¹€à¸£à¸µà¸¢à¸™|quiz|à¹à¸šà¸šà¸—à¸”à¸ªà¸­à¸š|à¸„à¸°à¹à¸™à¸™|score)/.test(t)) entities.lessonType = 'lesson';
  if (/(à¸žà¸­à¸£à¹Œà¸•|portfolio|à¸«à¸¸à¹‰à¸™|stock|à¸‹à¸·à¹‰à¸­|buy|à¸‚à¸²à¸¢|sell)/.test(t)) entities.portfolioAction = 'portfolio';

  // Security/Relay
  if (/(à¸£à¸µà¹€à¸¥à¸¢à¹Œ|relay|à¸ªà¸§à¸´à¸•à¸Šà¹Œ|switch|à¸›à¸´à¸”|à¹€à¸›à¸´à¸”|on|off).*(à¹„à¸Ÿ|light|à¸›à¸±à¹Šà¸¡|pump|à¸žà¸±à¸”à¸¥à¸¡|fan|à¸™à¹‰à¸³|water)/.test(t)) {
    entities.relayAction = /(à¸›à¸´à¸”|off)/.test(t) ? 'off' : 'on';
    const relayMatch = t.match(/(relay|à¸£à¸µà¹€à¸¥à¸¢à¹Œ)\s*(\d+)/i);
    if (relayMatch) entities.relayId = relayMatch[2];
  }
  if (/(à¸¥à¹‡à¸­à¸|lock|à¸›à¸¥à¸”à¸¥à¹‡à¸­à¸|unlock)/.test(t)) entities.lockAction = /(à¸›à¸¥à¸”à¸¥à¹‡à¸­à¸|unlock)/.test(t) ? 'unlock' : 'lock';
  if (/(à¸à¸¥à¹‰à¸­à¸‡|camera|à¸à¸²à¸£à¸•à¸£à¸§à¸ˆà¸ˆà¸±à¸š|detection|à¸„à¸™à¹à¸›à¸¥à¸|stranger)/.test(t)) entities.securityCheck = true;

  // Energy
  if (/(à¹à¸šà¸•à¹€à¸•à¸­à¸£à¸µà¹ˆ|battery|à¹‚à¸‹à¸¥à¹ˆà¸²|solar|inverter|à¸Šà¸²à¸£à¹Œà¸ˆ|charge)/.test(t)) {
    entities.energyType = 'battery';
    const chargeMatch = t.match(/(à¸Šà¸²à¸£à¹Œà¸ˆ|charge)\s*(\d+)\s*%/);
    if (chargeMatch) entities.targetPercent = parseInt(chargeMatch[1]);
  }

  // Query entities
  if (/status|à¸ªà¸–à¸²à¸™à¸°|à¸„à¹ˆà¸²|value|à¹€à¸—à¹ˆà¸²à¹„à¸«à¸£à¹ˆ|à¹€à¸—à¹ˆà¸²à¹„à¸£|à¸„à¸·à¸­à¹€à¸—à¹ˆà¸²à¹„à¸«à¸£à¹ˆ/.test(t)) {
    if (/(à¸™à¹‰à¸³|water)/.test(t)) entities.queryMetric = 'water_level_cm';
    else if (/(à¹à¸šà¸•|battery|à¹à¸šà¸•à¹€à¸•à¸­à¸£à¸µà¹ˆ)/.test(t)) entities.queryMetric = 'battery_soc';
    else if (/(à¹„à¸Ÿ|power|electric|à¸žà¸¥à¸±à¸‡à¸‡à¸²à¸™|energy)/.test(t)) entities.queryMetric = 'power_kw';
    else if (/(à¸­à¸¸à¸“à¸«à¸ à¸¹à¸¡à¸´|temp|temperature)/.test(t)) entities.queryMetric = 'temperature';
    else if (/(à¸„à¸§à¸²à¸¡à¸Šà¸·à¹‰à¸™|humidity|concentration)/.test(t)) entities.queryMetric = 'humidity';
  }

  // Confidence based on how many entities found
  const entityCount = Object.keys(entities).length;
  const confidence = Math.min(0.5 + entityCount * 0.15, 0.9);

  return {
    intent,
    entities,
    confidence,
    action: intent !== 'help' ? { endpoint: `/api/${intent}`, method: 'POST', payload: entities } : undefined,
  };
}

// GET /api/ai/local-status â€” à¸ªà¸§à¸´à¸•à¸Šà¹Œ AI à¹ƒà¸™à¹€à¸„à¸£à¸·à¹ˆà¸­à¸‡ (default à¸›à¸´à¸” â€” à¸•à¹‰à¸­à¸‡à¸à¸”à¹€à¸›à¸´à¸”à¹ƒà¸™à¹à¸­à¸›)
router.get('/local-status', authenticate, async (_req, res) => {
  const { getAiEnabled } = await import('../../services/local-llm.service');
  const s = await getAiEnabled();
  res.json(s);
});

// PUT /api/ai/enabled {enabled: bool} â€” à¹€à¸›à¸´à¸”/à¸›à¸´à¸” AI à¹ƒà¸™à¹€à¸„à¸£à¸·à¹ˆà¸­à¸‡ (SUPERADMIN)
router.put('/enabled', authenticate, requireRole('SUPERADMIN'), async (req, res) => {
  const { setAiEnabled } = await import('../../services/local-llm.service');
  const enabled = !!req.body?.enabled;
  const r = await setAiEnabled(enabled);
  res.json(r);
});

// PUT /api/ai/model {model: string} â€” à¹€à¸¥à¸·à¸­à¸à¹‚à¸¡à¹€à¸”à¸¥ (SUPERADMIN)
router.put('/model', authenticate, requireRole('SUPERADMIN'), async (req, res) => {
  try {
    const { setAiModel } = await import('../../services/local-llm.service');
    await setAiModel(String(req.body?.model || ''));
    res.json({ success: true });
  } catch (e: any) {
    res.status(400).json({ error: e.message });
  }
});

// GET /api/ai/status â€” à¸ªà¸–à¸²à¸™à¸° AI: Ollama à¸­à¸­à¸™à¹„à¸¥à¸™à¹Œà¹„à¸«à¸¡, à¹‚à¸¡à¹€à¸”à¸¥à¸—à¸µà¹ˆà¹ƒà¸Šà¹‰, à¸—à¸£à¸±à¸žà¸¢à¸²à¸à¸£à¸£à¸°à¸šà¸š
router.get('/status', authenticate, async (_req, res) => {
  let ollamaOnline = false;
  let models: Array<{ name: string; size: string }> = [];
  try {
    const r = await axios.get(`${OLLAMA_URL}/api/tags`, { timeout: 4000 });
    ollamaOnline = true;
    models = ((r.data?.models as any[]) || []).map((m) => ({
      name: m.name,
      size: m.size != null ? (m.size / 1024 / 1024 / 1024).toFixed(1) + ' GB' : '?',
    }));
  } catch {
    ollamaOnline = false;
  }

  const totalMem = os.totalmem();
  const freeMem = os.freemem();
  const load = os.loadavg();
  const cpuCount = os.cpus().length;

  res.json({
    ollamaOnline,
    ollamaUrl: OLLAMA_URL,
    currentModel: await getModelForTask('GENERAL_ASSISTANT', CURRENT_MODEL),
    models,
    resources: {
      cpuCores: cpuCount,
      cpuUsagePercent: cpuCount > 0 ? Math.min(100, Math.round((load[0] / cpuCount) * 100)) : null,
      memoryTotalGb: Number((totalMem / 1024 / 1024 / 1024).toFixed(1)),
      memoryFreeGb: Number((freeMem / 1024 / 1024 / 1024).toFixed(1)),
      memoryUsedPercent: totalMem > 0 ? Math.round(((totalMem - freeMem) / totalMem) * 100) : null,
    },
    uptimeSeconds: os.uptime(),
  });
});

// GET /api/ai/policy â€” à¸£à¸°à¸”à¸±à¸š autonomy à¸›à¸±à¸ˆà¸ˆà¸¸à¸šà¸±à¸™ + à¸ªà¸´à¸—à¸˜à¸´à¹Œà¸‚à¸­à¸‡à¹à¸•à¹ˆà¸¥à¸° tool
router.get('/policy', authenticate, (req, res) => {
  const autonomy = agentPolicy.getAutonomy();
  const tools = Object.entries(AGENT_TOOLS).map(([name, tool]) => ({
    name,
    kind: tool.kind,
    description: tool.description,
    available: tool.kind === 'read-only' || autonomy !== 'view',
  }));
  res.json({
    autonomy,
    approvalTtlMs: agentPolicy.getApprovalTtlMs(),
    protectedIps: agentPolicy.getProtectedIps(),
    protectedProcesses: agentPolicy.getProtectedProcesses(),
    tools,
  });
});

// PUT /api/ai/policy â€” à¹€à¸›à¸¥à¸µà¹ˆà¸¢à¸™à¸£à¸°à¸”à¸±à¸š autonomy (Superadmin à¹€à¸—à¹ˆà¸²à¸™à¸±à¹‰à¸™)
router.put('/policy', authenticate, requireRole('SUPERADMIN'), (req, res) => {
  const { autonomy } = req.body;
  if (!autonomy) return res.status(400).json({ error: 'autonomy is required' });
  try {
    agentPolicy.setAutonomy(autonomy);
    res.json({ autonomy: agentPolicy.getAutonomy() });
  } catch (err: any) {
    res.status(400).json({ error: err.message });
  }
});

// GET /api/ai/approvals â€” à¸£à¸²à¸¢à¸à¸²à¸£à¸„à¸³à¸‚à¸­à¸­à¸™à¸¸à¸¡à¸±à¸•à¸´ (pending + à¸›à¸£à¸°à¸§à¸±à¸•à¸´à¸¥à¹ˆà¸²à¸ªà¸¸à¸”)
router.get('/approvals', authenticate, requireRole('SUPERADMIN'), (req, res) => {
  res.json(agentActions.listApprovals());
});

// POST /api/ai/approvals/:id/approve â€” à¸­à¸™à¸¸à¸¡à¸±à¸•à¸´à¹à¸¥à¸°à¸ªà¸±à¹ˆà¸‡à¹ƒà¸«à¹‰à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£
router.post('/approvals/:id/approve', authenticate, requireRole('SUPERADMIN'), async (req, res) => {
  const result = await agentActions.approveApproval(req.params.id, req.user?.id);
  if (result.status === 'denied') {
    return res.status(400).json(result);
  }
  res.json(result);
});

// POST /api/ai/approvals/:id/reject â€” à¸›à¸à¸´à¹€à¸ªà¸˜à¸„à¸³à¸‚à¸­
router.post('/approvals/:id/reject', authenticate, requireRole('SUPERADMIN'), (req, res) => {
  const result = agentActions.rejectApproval(req.params.id, req.user?.id);
  if (!result) {
    return res.status(404).json({ error: 'Approval not found or already decided' });
  }
  res.json(result);
});

// â”€â”€ P1: Conversational Memory â€” à¸›à¸£à¸°à¸§à¸±à¸•à¸´à¸ªà¸™à¸—à¸™à¸² â”€â”€

// GET /api/ai/history â€” à¸›à¸£à¸°à¸§à¸±à¸•à¸´à¸à¸²à¸£à¸ªà¸™à¸—à¸™à¸²à¸¥à¹ˆà¸²à¸ªà¸¸à¸” (?limit=, default 50, max 200)
router.get('/history', authenticate, async (req, res) => {
  try {
    const limit = Math.min(Math.max(parseInt(String(req.query.limit || '50'), 10) || 50, 1), 200);
    const rows = await chatMemory.listHistory(String(req.user?.id), limit);
    res.json({
      history: rows.map((r) => ({
        id: r.id,
        role: r.role,
        content: r.content,
        created_at: r.created_at,
      })),
    });
  } catch (err) {
    console.error('Chat history error:', err);
    res.status(500).json({ error: 'Failed to load chat history' });
  }
});

// DELETE /api/ai/history â€” à¸¥à¹‰à¸²à¸‡à¸›à¸£à¸°à¸§à¸±à¸•à¸´à¸—à¸±à¹‰à¸‡à¸«à¸¡à¸” (à¸—à¸¸à¸à¸„à¸™à¹ƒà¸™à¸šà¹‰à¸²à¸™à¹ƒà¸Šà¹‰à¸£à¹ˆà¸§à¸¡?)
router.delete('/history', authenticate, async (req, res) => {
  const count = await chatMemory.clearHistory(String(req.user?.id));
  res.json({ success: true, deleted: count });
});

// DELETE /api/ai/history/:id â€” à¸¥à¸šà¸‚à¹‰à¸­à¸„à¸§à¸²à¸¡à¹€à¸”à¸µà¸¢à¸§
router.delete('/history/:id', authenticate, async (req, res) => {
  const ok = await chatMemory.deleteMessage(req.params.id, String(req.user?.id));
  if (!ok) return res.status(404).json({ error: 'Message not found' });
  res.json({ success: true });
});

// â”€â”€ P2: Decision Support AI â€” à¸–à¸²à¸¡ "à¸„à¸§à¸£à¸—à¸³à¸­à¸°à¹„à¸£à¸”à¸µ" à¸ˆà¸²à¸à¸‚à¹‰à¸­à¸¡à¸¹à¸¥à¸ˆà¸£à¸´à¸‡ â”€â”€

// POST /api/ai/advisor â€” à¸§à¸´à¹€à¸„à¸£à¸²à¸°à¸«à¹Œà¸ˆà¸²à¸à¸ªà¸–à¸²à¸™à¸à¸²à¸£à¸“à¹Œà¸ˆà¸£à¸´à¸‡ â†’ à¸„à¸³à¹à¸™à¸°à¸™à¸³à¹„à¸—à¸¢
router.post('/advisor', authenticate, async (req, res) => {
  const question = String(req.body?.question || '').trim();
  if (!question) return res.status(400).json({ error: 'question is required' });
  if (question.length > 2000) return res.status(400).json({ error: 'question too long (max 2000)' });
  try {
    const context = await advisor.buildSituationContext();
    const advice = await advisor.askAdvisor(question, context);
    res.json({ question, advice, context });
  } catch (err) {
    console.error('Advisor route error:', err);
    res.status(500).json({ error: 'Advisor failed' });
  }
});

// POST /api/ai/advisor/what-if â€” à¸ªà¸–à¸²à¸™à¸à¸²à¸£à¸“à¹Œà¸ˆà¸³à¸¥à¸­à¸‡ (à¸à¸™à¹„à¸¡à¹ˆà¸•à¸/à¹„à¸Ÿà¹„à¸¡à¹ˆà¸¡à¸µ/à¸„à¹ˆà¸²à¹ƒà¸Šà¹‰à¸ˆà¹ˆà¸²à¸¢à¸‚à¸¶à¹‰à¸™)
router.post('/advisor/what-if', authenticate, async (req, res) => {
  const scenario = String(req.body?.scenario || '');
  const days = Math.floor(Number(req.body?.days));
  if (!advisor.WHAT_IF_SCENARIOS.includes(scenario as any)) {
    return res.status(400).json({ error: `invalid scenario (${advisor.WHAT_IF_SCENARIOS.join('|')})` });
  }
  if (!(days >= 1 && days <= 365)) {
    return res.status(400).json({ error: 'days must be a number 1-365' });
  }
  try {
    const context = await advisor.buildSituationContext();
    const computed = advisor.runWhatIf(context, { scenario: scenario as any, days });
    const advice = await advisor.summarizeImpact(computed, context);
    res.json({ params: { scenario, days }, computed, advice, context });
  } catch (err) {
    console.error('Advisor what-if route error:', err);
    res.status(500).json({ error: 'What-if failed' });
  }
});

// POST /api/ai/voice-command â€” parse à¹€à¸ªà¸µà¸¢à¸‡à¸žà¸¹à¸” â†’ intent + entities + action à¸—à¸µà¹ˆà¸žà¸£à¹‰à¸­à¸¡ execute
router.post('/voice-command', authenticate, async (req, res) => {
