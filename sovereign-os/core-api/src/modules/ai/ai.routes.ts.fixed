function getMetricUnit(metric: string): string {
  const units: Record<string, string> = {
    water_level_cm: 'cm',
    battery_soc: '%',
    power_kw: 'kW',
    temperature: 'Â°C',
    humidity: '%',
    soil_moisture: '%',
    ec_value: 'dS/m',
    ph: 'pH',
  };
  return units[metric] || '';
}

