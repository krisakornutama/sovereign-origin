{
  "version": 1,
  "updated": "2026-10-19",
  "notes": "Hardware tiers for the Sovereign Edge AI pack. Model tags are Ollama tags. Sizes are approximate Q4/Q8 pulls, not exact bytes.",
  "profiles": {
    "nano": {
      "label": "Nano - 8 GB RAM / 4 cores / no usable GPU",
      "when": { "minRamGB": 7, "maxRamGB": 11.9 },
      "ollama": {
        "numParallel": 1,
        "maxLoadedModels": 1,
        "contextLength": 2048,
        "maxQueue": 8,
        "keepAlive": "15m",
        "flashAttention": 1,
        "kvCacheType": "q8_0",
        "multiUserCache": 1,
        "numThreads": 4,
        "forceCpu": true,
        "loadTimeout": "10m"
      },
      "gateway": {
        "maxConcurrent": 1,
        "perUserConcurrent": 1,
        "maxQueue": 8,
        "queueTimeoutMs": 120000,
        "cacheTtlMs": 300000,
        "cacheMaxEntries": 100,
        "maxHistoryMessages": 6,
        "maxPromptChars": 8000
      },
      "models": {
        "fast": "qwen3:0.6b",
        "main": "gemma3:1b",
        "deep": null,
        "embed": "nomic-embed-text",
        "vision": "gemma3:4b"
      },
      "rollout": {
        "allowDeep": false,
        "deepRequiresOptIn": false,
        "deepPolicy": "downgrade"
      }
    },
    "mini": {
      "label": "Mini - 16 GB RAM / 8 cores / integrated GPU",
