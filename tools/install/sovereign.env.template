# ============================================================================
# Sovereign OS — One-Click Install Environment Template
# ไฟล์นี้คือต้นแบบของ infra/.env — install.sh / install.ps1 จะสร้าง .env จากไฟล์นี้
# โดยแทนที่ __GEN_*__ ด้วยค่าสุ่มอัตโนมัติ และถามโจทย์ที่จำเป็น (หรือใช้ --auto)
#
# กติกา:
#   - KEY=value ตรง ๆ  = ค่า default ที่ปลอดภัย (ข้ามได้ถ้าไม่แน่ใจ)
#   - __GEN_<name>__   = สุ่มให้อัตโนมัติ (ไม่ต้องแก้)
#   - ค่าว่าง (ปล่อย =) = เปิด feature แค่เมื่อกรอกค่า (เช่น Telegram)
# ============================================================================

# ── Database (PostgreSQL + TimescaleDB) ──────────────────────────────────────
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=__GEN_SECRET_24__
POSTGRES_DB=sovereign_v2
TIMESCALE_HOST=timescaledb
TIMESCALE_DB=sovereign_v2
TIMESCALE_USER=sovereign
TIMESCALE_PASSWORD=__GEN_SECRET_24__

# ── Auth / Security ──────────────────────────────────────────────────────────
JWT_SECRET=__GEN_SECRET_48__
SEED_ADMIN_PASSWORD=__GEN_PASSWORD_16__
OTA_TOKEN=__GEN_SECRET_32__
CORS_ORIGIN=*

# ── MQTT Broker (EMQX) ───────────────────────────────────────────────────────
EMQX_USERNAME=sovereign
EMQX_PASSWORD=__GEN_SECRET_24__

# ── Threat & Risk (เปิด default — dry-run ป้องกันทุก action จริง) ────────────
THREAT_DETECTION_ENABLED=true
THREAT_INTEL_FEED_URLS=
THREAT_INTEL_FEED_INTERVAL_HOURS=24
THREAT_INTEL_MAX_ITEMS=100
THREAT_ALLOWLIST_IPS=
THREAT_CONNECTION_THRESHOLD=50
RISK_MONITOR_ENABLED=true
RISK_FEEDS=
RISK_MODEL=
DEFCON_ENABLED=true
DEFCON_DRY_RUN=true

# ── Resilient Backup (Mesh Offsite — ทุกเครื่องรันได้เลย) ────────────────────
MESH_ENABLED=true
MESH_RSYNC_TARGET=
MESH_SCP_TARGET=
OFFSITE_RETAIN=30

# ── Telemetry ────────────────────────────────────────────────────────────────
TELEMETRY_FLUSH_MS=60000

# ── Power / UPS (ต้องมี UPS + NUT server ถึงเปิด) ─────────────────────────────
UPS_ENABLED=false
UPS_HOST=localhost
UPS_PORT=3493
UPS_NAME=ups
UPS_SHUTDOWN_BATTERY_PCT=15
UPS_SHUTDOWN_RUNTIME_SEC=180
UPS_DRY_RUN=true

# ── Telegram Remote Alerts (ใส่ token ถึงเปิด) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DASHBOARD_URL=
TELEGRAM_MIN_SEVERITY=warn

# ── Home / Lifestyle (ตั้งค่าบ้าน) ───────────────────────────────────────────
HOME_LATITUDE=15.0
HOME_LONGITUDE=100.0
LIFESTYLE_ENABLED=true
MANUAL_DAY_HOURS=24
ENERGY_CAPACITY_KWH=5
ELECTRICITY_PRICE_USD_PER_KWH=0.12

# ── AI (Ollama — ปิด default; เปิดด้วย --with-ollama หรือตั้งเอง) ─────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
EMBED_MODEL=
AI_ANALYST_ENABLED=false
PORTFOLIO_ENABLED=false
PORTFOLIO_CASH_USD=0
PORTFOLIO_MONTHLY_EXPENSES_USD=0
