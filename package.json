{
  "name": "sovereign-origin",
  "version": "1.3.6",
  "private": true,
  "description": "Sovereign Origin — Self-Sovereign Home OS (monorepo ของ sovereign-frontend + sovereign-os/core-api)",
  "scripts": {
    "queue": "node tools/queue/queue.mjs",
    "license": "node tools/license/issue.mjs",
    "verify": "node tools/verify.mjs",
    "verify:full": "node tools/verify.mjs --e2e",
    "build:desktop": "node tools/build-desktop.mjs",
    "e2e": "cd sovereign-frontend && npm run e2e",
    "test:tools": "node --test --test-force-exit --test-timeout=120000 \"tools/test/**/*.test.mjs\"",
    "test:db": "node tools/test-db-local.mjs",
    "coverage:core": "node tools/coverage-core.mjs",
    "health": "node tools/system-health.mjs",
    "clean:logs": "node tools/clean-logs.mjs",
    "preview:stack": "node tools/preview-stack.mjs",
    "preview:check": "node tools/preview-stack.mjs --check",
    "stage:release": "node tools/stage-release.mjs",
    "release:check": "node tools/release-check.mjs"
  }
}
