    "coverage:core": "node tools/coverage-core.mjs",
    "health": "node tools/system-health.mjs",
    "clean:logs": "node tools/clean-logs.mjs",
    "preview:stack": "node tools/preview-stack.mjs",
    "preview:check": "node tools/preview-stack.mjs --check"
  }
}
