# คัดลอกไฟล์นี้ไปเป็น `.env.local` ในโฟลเดอร์ sovereign-frontend/ แล้วเติมค่าจริง
# คำสั่ง: cp .env.local.example .env.local   (Windows: copy .env.local.example .env.local)

# URL ของ Core API (เบราว์เซอร์ฝั่ง client เข้าถึงได้)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL ของ WebSocket (Socket.IO)
NEXT_PUBLIC_WS_URL=http://localhost:3001
