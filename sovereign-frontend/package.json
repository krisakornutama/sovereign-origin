{
  "name": "sovereign-frontend",
  "version": "1.1.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sw-precache.mjs",
    "build:static": "node scripts/build-static.mjs && node scripts/generate-sw-precache.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "test:mbti": "playwright test --config=playwright.mbti.config.ts",
    "test:mbti:real": "playwright test --config=playwright.mbti-real.config.ts",
    "electron": "electron .",
    "electron:build": "npm run build:static && electron-builder --win --x64"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "next": "^16.3.6",
    "react": "^18",
    "react-dom": "^18",
    "socket.io-client": "^4.7.5",
    "three": "^0.186.0",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.sovereign.os",
    "productName": "Sovereign OS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../sovereign-os/core-api/dist",
        "to": "core-api/dist"
      },
      {
        "from": "../sovereign-os/core-api/prisma",
        "to": "core-api/prisma"
      },
      {
        "from": "../sovereign-os/core-api/package.json",
        "to": "core-api/package.json"
      },
      {
        "from": "../sovereign-os/core-api/node_modules",
        "to": "core-api/node_modules"
      },
      {
        "from": "out",
        "to": "out"
      }
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Sovereign-OS-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
