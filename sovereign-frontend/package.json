{
  "name": "sovereign-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sw-precache.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "electron": "electron .",
    "electron:build": "next build && electron-builder --win --x64"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "next": "^16.3.0",
    "react": "^18",
    "react-dom": "^18",
    "socket.io-client": "^4.7.5",
    "three": "^0.185.1",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.sovereign.os",
    "productName": "Sovereign OS",
    "directories": { "output": "dist-electron" },
    "files": ["electron/**/*", "out/**/*", "public/**/*", "package.json"],
    "extraResources": [{ "from": "../sovereign-os/core-api/dist", "to": "core-api/dist" }, { "from": "../sovereign-os/core-api/prisma", "to": "core-api/prisma" }, { "from": "../sovereign-os/core-api/package.json", "to": "core-api/package.json" }],
    "win": { "target": "nsis", "icon": "public/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.4",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
