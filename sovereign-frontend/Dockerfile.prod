# ── Production build (multi-stage): next build → next start ──
# Next 16 บังคับ Node >= 20.9 — node:18 จะพังตั้งแต่ `next build`
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# ใช้ค่าเริ่มต้นเดิมได้ แต่ deploy ที่เปิดจากเครื่องอื่น (เช่น Raspberry Pi) ต้อง override ตอน build
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# build script รัน next build + generate-sw-precache (PWA) เอง
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/next.config.js ./
COPY --from=build /app/tsconfig.json ./
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["npm", "start"]
