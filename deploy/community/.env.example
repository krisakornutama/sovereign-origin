# ─────────────────────────────────────────────────────────────────────────────
# Sovereign OS — Community Edition
# คัดลอกเป็น .env แล้วแก้เฉพาะ 3 ค่าที่มี [ต้องตั้ง]
#   cp .env.example .env
# สร้างรหัสสุ่ม:  openssl rand -hex 24   (Windows: ใช้ Git Bash หรือ `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`)
# ─────────────────────────────────────────────────────────────────────────────

# ── ฐานข้อมูล (TimescaleDB) ─────────────────────────────────────────────────
POSTGRES_USER=sovereign
# [ต้องตั้ง] รหัสผ่านฐานข้อมูล — ห้ามใช้ค่าเดิม/ห้ามใช้ตัวอย่างนี้
POSTGRES_PASSWORD=
POSTGRES_DB=sovereign

# ── MQTT (EMQX) ─────────────────────────────────────────────────────────────
EMQX_USERNAME=admin
# [ต้องตั้ง] รหัสผ่าน dashboard EMQX (http://localhost:18083)
EMQX_PASSWORD=

# ── Core API ────────────────────────────────────────────────────────────────
# [ต้องตั้ง] ความลับสำหรับเซ็น JWT — สุ่มอย่างน้อย 32 ตัวอักษร
JWT_SECRET=

# รหัสผ่าน admin คนแรก (อย่างน้อย 12 ตัวอักษร)
# ถ้าเว้นว่าง ระบบจะสุ่มให้ — บันทึกจาก log ของ service `migrate` ครั้งแรก
SEED_ADMIN_PASSWORD=

# เปิดเฉพาะโมดูลที่ใช้ (เว้นว่าง = เปิดทั้งหมดตามค่าเริ่มต้น)
# ตัวอย่าง: ENABLED_MODULES=inventory,farm
ENABLED_MODULES=

# ── การเข้าถึง ──────────────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=3001
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083

# ใช้ในเครื่องนี้เครื่องเดียว (ปลอดภัยสุด)
API_BIND=127.0.0.1
WEB_BIND=0.0.0.0

# ถ้าจะเปิดจากเครื่องอื่นใน LAN:
#   API_BIND=0.0.0.0
#   NEXT_PUBLIC_API_URL=http://<ip-ของเครื่องนี้>:3001
#   แล้วสั่ง `docker compose up -d --build web`
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Prebuilt images (ไม่บังคับ) ─────────────────────────────────────────────
# ใช้ image ที่ GitHub Actions build ขึ้น GHCR แทนการ build เองบนเครื่อง:
#   API_IMAGE=ghcr.io/krisakornutama/sovereign-origin/api:1.2.0
#   WEB_IMAGE=ghcr.io/krisakornutama/sovereign-origin/web:1.2.0
# tag บน GHCR ไม่มีคำนำหน้า v (push git tag v1.2.0 → ได้ image tag 1.2.0, 1.2, latest)
# แล้วรัน: docker compose up -d --pull always   (ไม่ต้องใส่ --build)
# เว้นว่าง = build จากซอร์สเหมือนเดิม
API_IMAGE=
WEB_IMAGE=

# ── การแจ้งเตือน (ไม่บังคับ) ────────────────────────────────────────────────
# ได้ token จาก @BotFather → chat id จาก @userinfobot (หรือ -100... สำหรับกลุ่ม)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=warn

# Discord: Server Settings → Integrations → Webhooks → Copy Webhook URL
#   ต้องเป็น https://discord.com/api/webhooks/... เท่านั้น
DISCORD_WEBHOOK_URL=
# LINE Messaging API (ไม่ใช่ LINE Notify ที่ปิดบริการแล้ว)
#   token: LINE Developers Console → Messaging API · LINE_TO: U/C/R + 32 hex
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# ── เบ็ดเตล็ด ───────────────────────────────────────────────────────────────
TZ=Asia/Bangkok
