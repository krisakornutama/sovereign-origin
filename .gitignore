# ─────────────────────────────────────────────
# Project Sovereign – root .gitignore
# ใช้กับทุกโฟลเดอร์ย่อย (pattern ไม่มี / หน้าสุด = ทุกระดับ)
# ─────────────────────────────────────────────

# ── Dependencies ─────────────────────────────
node_modules/
**/node_modules/

# ── Build output ─────────────────────────────
.next/
out/
dist/
build/
*.tsbuildinfo

# ── Environment & secrets ────────────────────
.env
.env.*
!.env.example
!.env.local.example

# ── Runtime / logs ───────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Keys & certificates ──────────────────────
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.keystore

# ── Python ───────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Docker runtime data ──────────────────────
**/infra/data/
pgdata/

# ── Backup files (DB dumps) ──────────────────
backups/
**/backups/
*.sql.gz

# ── PM2 logs / certs (production) ────────────
**/infra/logs/
**/infra/certs/

# ── PWA build artifacts ──────────────────────
public/sw-precache.json

# ── Editor / OS ──────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Freebuff / tooling runtime ────────────────
.freebuff/
.agents/

# ── Docker Desktop runtime state (not project code) ──
Docker/

# ── Installers / binaries ──────────────────────
tools/
Ollama/

# ── Keys & certificates (เพิ่มเติม) ─────────────
id_ed25519*
id_rsa*

# ── Log files (รวม .log.err / .log.*) ───────────
*.log.*

# ── Scratch / probe files ──────────────────────
wd-probe.txt
structure.txt

# ── Tests / coverage ─────────────────────────
coverage/
.nyc_output/

# Next-Gen Security runtime state (app-control blocklist, ids offset, ai analyst report)
**/core-api/data/
