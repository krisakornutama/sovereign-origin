# ─────────────────────────────────────────────
# Project Sovereign – root .gitignore
# ใช้กับทุกโฟลเดอร์ย่อย (pattern ไม่มี / หน้าสุด = ทุกระดับ)
# ─────────────────────────────────────────────

# ── Dependencies ─────────────────────────────
node_modules/
**/node_modules/

# ── Build output ─────────────────────────────
# นโยบาย: artifact สร้างใหม่ได้ทั้งหมด ห้ามเข้า git — ประวัติเคยบวม 13.5GB จากของพวกนี้
# (ทางแก้ครั้งนั้นคือ filter-repo; กลับมาอีก = เจ็บกว่าเดิมหลายเท่า — ต้องกันตั้งแต่ commit เดียว)
.next/
out/
dist/
dist-*/
build/
*.tsbuildinfo

# ── ไบนารี/แพ็กเกจขนาดใหญ่ (สร้างใหม่หรือดาวน์โหลดได้ — ไม่ใช่ซอร์ส) ──
*.exe
*.dll
*.pak
*.asar
*.gguf
*.bin
*.zip
*.msi
*.apk
*.dmg
*.AppImage

# ── Environment & secrets ────────────────────
.env
.env.*
!.env.example
!.env.local.example

# ── Runtime / logs ───────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Keys & certificates ──────────────────────
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.keystore

# ── Python ───────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Docker runtime data ──────────────────────
**/infra/data/
pgdata/

# ── Backup files (DB dumps) ──────────────────
backups/
**/backups/
*.sql.gz

# ── PM2 logs / certs (production) ────────────
**/infra/logs/
**/infra/certs/

# ── PWA build artifacts ──────────────────────
sovereign-frontend/public/sw-precache.json

# ── Editor / OS ──────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Freebuff / tooling runtime ────────────────
.freebuff/
.agents/
.publish-tmp/  # publish โหมด CI: clone mirror ชั่วคราว

# ── Docker Desktop runtime state (not project code) ──
Docker/

# ── Installers / binaries ──────────────────────
tools/*
!tools/build-desktop.mjs
!tools/verify.mjs
!tools/publish-portfolio.mjs
!tools/indexnow-notify.mjs
!tools/portfolio-preview-server.mjs
!tools/test/
!tools/test/*.test.mjs
!tools/
!tools/install/
tools/install/*
!tools/install/install.sh
!tools/install/install.ps1
!tools/install/sovereign.env.template
!tools/sovereign-launcher/
tools/sovereign-launcher/*
!tools/sovereign-launcher/go.mod
!tools/sovereign-launcher/main.go
!tools/sovereign-launcher/build.ps1
!tools/sovereign-launcher/web/
tools/sovereign-launcher/SovereignOS-Setup.exe
Ollama/

# ── Keys & certificates (เพิ่มเติม) ─────────────
id_ed25519*
id_rsa*

# ── Log files (รวม .log.err / .log.*) ───────────
*.log.*

# ── Scratch / probe files ──────────────────────
wd-probe.txt
structure.txt

# ── Tests / coverage ─────────────────────────
coverage/
.nyc_output/

# Next-Gen Security runtime state (app-control blocklist, ids offset, ai analyst report)
**/core-api/data/

# Runtime data (offsite encrypted backups, knowledge uploads) — ไม่ควรเข้าสู่ git
**/infra/offsite/
**/knowledge/uploads/

# DMS firmware config (secret — อย่า commit)
dms-firmware/config.py

# ── Credentials generated by installers (critical) ──
**/.credentials
.credentials
infra/.credentials
sovereign-os/infra/.credentials

# ── Junk files from shell parsing bug ──
sovereign-os/infra/void
sovereign-os/infra/docker
sovereign-os/infra/\(
sovereign-os/infra/\{
sovereign-os/infra/\[...prev

# Playwright E2E
sovereign-frontend/e2e/.auth/
sovereign-frontend/playwright-report/
sovereign-frontend/test-results/

# Local LLM models (GGUF — หลาย GB อย่า commit)
sovereign-os/core-api/models/*.gguf
sovereign-os/core-api/models/*.bin

frontend-watchdog.mjs

# ── Desktop dist (rebuildable — ไม่ commit binaries ใหญ่) ──
sovereign-frontend/dist-electron/
dist-portable/_backup/
dist-portable/Sovereign OS.exe
dist-portable/resources/app.asar
dist-portable/resources/default_app.asar
dist-portable/resources/core-api/prisma/**/*.db
dist-portable/LICENSE
dist-portable/version

# ── dist-portable generated copies (regenerated by build:desktop จากซอร์สเสมอ —
#    เคย commit ทั้งที่เป็น copy → drift จน exe รันโค้ดเก่า 09-11; ต่อไป sync ตอน build)
dist-portable/resources/
dist-portable/Docker

# ── Desktop overlay experiment copies (ไม่ใช่ของจริง) ──
dist-portable-copy/

# ── Secrets / credentials (ห้ามเข้า git เด็ดขาด) ──
admin-mfa-qr.png
admin-mfa-secret.txt
admin-credentials.txt
login.json
health.json

# ── Build artifacts ใหญ่ที่ root (สร้างใหม่ได้จาก electron:build) ──
/Sovereign-OS-Desktop-*.zip

# playwright e2e creds (local only)
.env.playwright
