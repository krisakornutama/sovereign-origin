{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coder-full",
  "permission": {
    "read": "allow",
    "edit": {
      "*": "allow",
      "sovereign-os/infra/**": "ask",
      "sovereign-os/infra/.env": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "ask",
    "external_directory": {
      "*": "ask",
      "C:/Users/com/AppData/Local/Temp/opencode/**": "allow"
    }
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2400,
      "max_height": 2400,
      "max_base64_bytes": 10485760
    }
  }
}